# Public configuration only. Never put a service role / secret key in this
# project: the app uses the publishable key, and the service role key lives
# only in Supabase as an Edge Function secret.
#
# The Angular app reads these values from src/environments/environment*.ts.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase CLI (used for `supabase link` / `db push` / `functions deploy`)
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# Local development only (used by supabase/scripts/create-local-admin.sh).
# These credentials exist only on your local Docker stack.
LOCAL_ADMIN_EMAIL=admin@tabibi.local
LOCAL_ADMIN_PASSWORD=local-admin-123
